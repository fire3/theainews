---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  // 以下均为可选：文章页传入后用于 Open Graph / Twitter / 结构化数据
  image?: string;
  author?: string;
  pubDate?: Date;
  type?: 'website' | 'article';
}

const {
  title,
  description,
  image,
  author,
  pubDate,
  type = 'website',
} = Astro.props;
const pageTitle = title ? `${title} — ${SITE.title}` : `${SITE.title} — ${SITE.subtitle}`;
const pageDescription = description ?? SITE.description;

// 所有绝对地址统一从 Astro.site 派生，避免在各页面里硬编码
const base = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, base).href;
const ogImage = new URL(image ?? SITE.defaultImage, base).href;
const isArticle = type === 'article' && Boolean(pubDate);

// 文章页输出 NewsArticle 结构化数据，其余页面不输出以免误导搜索引擎
const jsonLd = isArticle
  ? {
      '@context': 'https://schema.org',
      '@type': 'NewsArticle',
      headline: title ?? SITE.title,
      description: pageDescription,
      image: [ogImage],
      datePublished: pubDate!.toISOString(),
      author: author ? [{ '@type': 'Person', name: author }] : undefined,
      publisher: {
        '@type': 'Organization',
        name: SITE.title,
        logo: {
          '@type': 'ImageObject',
          url: new URL('/favicon.svg', base).href,
        },
      },
      url: canonicalURL,
      mainEntityOfPage: canonicalURL,
    }
  : null;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE.title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL('/rss.xml', base).href}
    />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
