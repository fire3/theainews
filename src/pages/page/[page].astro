---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeFeed from '../../components/HomeFeed.astro';
import { SITE } from '../../data/site';
import { getAllPosts, paginate, POSTS_PER_PAGE } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
  // 第 1 页由首页（/）渲染，这里生成第 2 页及以后
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const currentPage = Number(Astro.params.page);
const posts = await getAllPosts();
const { items, totalPages } = paginate(posts, currentPage);
---

<BaseLayout title={`第 ${currentPage} 页`} description={SITE.description}>
  <HomeFeed posts={posts} items={items} currentPage={currentPage} totalPages={totalPages} />
</BaseLayout>
