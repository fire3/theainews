---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeFeed from '../components/HomeFeed.astro';
import { SITE } from '../data/site';
import { getAllPosts, paginate } from '../lib/posts';

const posts = await getAllPosts();
const { items, totalPages } = paginate(posts, 1);
---

<BaseLayout description={SITE.description}>
  <HomeFeed posts={posts} items={items} currentPage={1} totalPages={totalPages} />
</BaseLayout>
