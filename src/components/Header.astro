---
import { SITE, CATEGORIES } from '../data/site';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="header clear">
  <div class="top-bar">
    <div class="top-bar-box">
      <span class="slogan">{SITE.tagline}</span>
    </div>
  </div>
  <div class="logo-area">
    <a class="logo-title" href="/">{SITE.title}</a>
    <span class="logo-sub">{SITE.subtitle}</span>
  </div>
</header>

<nav class="menu" aria-label="栏目导航">
  <div class="menu-box">
    <ul class="menu-ul">
      <li class:list={['menu-home', { 'is-active': isActive('/') }]}>
        <a href="/">首页</a>
      </li>
      {CATEGORIES.map((category) => (
        <li class:list={[{ 'is-active': isActive(category.href) }]}>
          <a href={category.href}>{category.name}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>
